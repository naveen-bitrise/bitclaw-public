{
  "display_information": {
    "name": "bitclaw",
    "description": "Slack-native AI engineering agent: routes every thread to a persistent Claude conversation and delegates coding work to disposable cloud dev environments.",
    "background_color": "#1f2430"
  },
  "features": {
    "bot_user": {
      "display_name": "bitclaw",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "reactions:write",
        "assistant:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
