{
  "mcpServers": {
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--toolsets", "context,issues,pull_requests,repos,users,actions"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"
      }
    },
    "infra": {
      "command": "bitrise-mcp-dev-environments",
      "args": [],
      "env": {
        "BITRISE_TOKEN": "$BITRISE_TOKEN",
        "BITRISE_WORKSPACE_ID": "$BITRISE_WORKSPACE_ID"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "$JIRA_AUTH"
      }
    }
  }
}
