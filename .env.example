# bitclaw configuration. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
#
# Integrations are TIERED (see README → Quickstart): step 1 alone gives you a
# talking bot; step 2 gives it hands (coding — the point of this repo);
# step 3 lets it ship PRs; Jira is optional. Unset vars simply disable their
# integration — the startup log prints a capability summary.

# ==== STEP 1 — chat (required) ================================================

# ---- Slack -----------------------------------------------------------------
# Bot OAuth token (xoxb-…) from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-…) with the connections:write scope, for Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token

# ---- Claude ----------------------------------------------------------------
# Claude API key. Alternatively leave unset if you are logged into the
# `claude` CLI — the Agent SDK inherits the CLI's session.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Model for the orchestrator agent.
#CLAUDE_MODEL=claude-sonnet-5

# ==== STEP 2 — give it hands: Bitrise RDE (the reason this repo exists) ======

# The coding agent runs in disposable cloud VMs (Bitrise Remote Dev
# Environments). Personal access token + the workspace that holds the
# coding-agent template.
BITRISE_TOKEN=
BITRISE_WORKSPACE_ID=
# The ONE RDE template bitclaw is allowed to launch (see docs/rde-template.md).
# Unset → devenv creation is denied by a PreToolUse hook (fail closed).
RDE_TEMPLATE_ID=

# ==== STEP 3 — let it ship: GitHub ===========================================

# PAT used by the GitHub MCP server AND by bitclaw's code-side trust and
# repo-visibility checks. Needs `repo` + `read:org` (read:org powers the
# org-membership fallback below).
GITHUB_TOKEN=
# HMAC-SHA256 shared secret for inbound GitHub webhooks.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The ONE GitHub org whose members may steer the agent via PR comment/review
# text. Author trust uses two signals, because neither suffices alone:
#   1. author_association on the signed webhook payload
#      (OWNER/MEMBER/COLLABORATOR trusted, no API call) — but PRIVATE org
#      members (GitHub's default) show up as CONTRIBUTOR/NONE;
#   2. fallback GET /orgs/{org}/members/{login}, authoritative regardless of
#      membership visibility.
# Fails CLOSED. There is no default and unset is NOT a kill switch: it just
# means the fallback can't confirm private members, so they are dropped too.
GITHUB_ALLOWED_ORG=your-github-org
# Optional: pin the bot's GitHub login for webhook self-echo filtering.
# Unset → resolved at startup via GET /user with GITHUB_TOKEN.
#GITHUB_BOT_LOGIN=

# ==== OPTIONAL — Jira =========================================================

# ---- Jira (leave unset to run without Jira) ---------------------------------
# `Basic base64(email:api_token)` Authorization header for the hosted
# Atlassian MCP server. Build it with:
#   echo -n "bot@example.com:your-api-token" | base64
#JIRA_AUTH=Basic your-base64-blob
# Your Atlassian site hostname; passed to the agent as the Jira cloudId.
#JIRA_HOST=example.atlassian.net
# Atlassian accountId of the bot user (assignment detection + self-echo filter).
#JIRA_BOT_ACCOUNT_ID=
# Secret embedded in the Jira webhook URL path: /webhooks/jira/<secret>
# (Jira Cloud webhooks can't send custom headers, hence path auth — this is
# also why bitclaw disables HTTP access logging). Generate: openssl rand -hex 32
#JIRA_WEBHOOK_SECRET=
# Slack channel ID where ticket-assignment webhooks bootstrap new threads.
#JIRA_DEFAULT_CHANNEL=C0123456789
# Jira statuses that count as terminal and trigger RDE cleanup.
#JIRA_TERMINAL_STATUSES=Done,Closed,Cancelled,Won't Do

# ==== Server / storage ========================================================
#WEBHOOK_HOST=0.0.0.0
#WEBHOOK_PORT=8080
# SQLite database file (sessions, anchors, scheduled messages).
#DB_PATH=./bitclaw.db
#LOG_LEVEL=INFO

# ==== Tuning (defaults are sensible) ==========================================
# In-memory session eviction: reclaim SDK/MCP subprocesses after idling this
# long (reversible — the DB row stays and the next inbound event rebuilds).
#SESSION_IDLE_TTL_SECS=3600
#SESSION_EVICTION_CHECK_SECS=300
# Durable auto-close: sessions with no inbound event for this many days are
# closed for good (otherwise abandoned rows are restored on every restart).
#SESSION_AUTOCLOSE_IDLE_DAYS=7
#SESSION_AUTOCLOSE_CHECK_SECS=3600
# Per-turn idle watchdog on the SDK response stream (catches wedged tool calls).
#AGENT_TURN_IDLE_TIMEOUT_SECS=600
# User stop: how long to wait after the graceful interrupt before escalating
# to worker teardown.
#STOP_GRACE_SECS=15
